newgraph
xaxis min -100 max 100 nodraw
yaxis min -100 max 100 nodraw

(* encapsulating oval *)
newcurve marktype ellipse marksize 121 162 fill 1 pts 0 -10
newcurve marktype ellipse marksize 120 160 fill 1 pts 0 -10

(* level line *)
newline poly pfill 0 pts
-35 0
35 0
35 -1
-35 -1

(* XP line *)
newline poly pfill 0 pts
-40 -55
-40 -56
40 -56
40 -55

(* LEVEL text *)
newstring font Times-Roman fontsize 15 x 0 y -10 hjc vjc :
LEVEL

(* XP text *)
newstring font Times-Roman fontsize 15 x 0 y -65 hjc vjc :
XP
