newgraph
xaxis min -100 max 100 nodraw
yaxis min -100 max 100 nodraw

(* bottom thick line *)
newline poly pfill 0 pts
-100 -67
-100 -68
100 -68
100 -67

(* left vertical thick line *)
newline poly pfill 0 pts
-100 -68
-100 68
-99 68
-99 -68

(* top thick line *)
newline poly pfill 0 pts
-100 68
-100 67
100 67
100 68

(* right thick line *)
newline poly pfill 0 pts
99 68
100 68
100 -68
99 -68








(* L1 acrobatics proficiency circle *)
newcurve marktype circle marksize 6 6 fill 1 pts -90.5 56

(* acrobatics modifier line *)
newline poly pfill 0 pts
-83.5 53
-83.5 53.01
-60 53.01
-60 53

(* acrobatics text *)
newstring font Helvetica fontsize 7 x -44 y 56 hjc vjc :
Acrobatics

