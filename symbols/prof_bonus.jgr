newgraph
xaxis min -100 max 100 nodraw
yaxis min -100 max 100 nodraw

(* bottom thick line *)
newline poly pfill 0 pts
-100 -48
-100 -50
100 -50
100 -48

(* left vertical thick line *)
newline poly pfill 0 pts
-100 -50
-100 50
-98 50
-98 -50

(* top thick line *)
newline poly pfill 0 pts
-100 50
-100 48
100 48
100 50

(* right thick line *)
newline poly pfill 0 pts
98 50
100 50
100 -50
98 -50

(* prof bonus seperator for title line *)
newline poly pfill 0 pts
-90 20
-90 21
90 21
90 20

(* prof bonus left line *)
newline poly pfill 0 pts
-40 20
-39 20
-39 -40
-40 -40

(* prof bonus bottom line *)
newline poly pfill 0 pts
-40 -40
-40 -39
40 -39
40 -40

(* prof bonus right line *)
newline poly pfill 0 pts
40 20
39 20
39 -40
40 -40

(* PROFICIENCY BONUS text *)
newstring font Helvetica fontsize 17 x 0 y 32 hjc vjc :
PROFICIENCY BONUS